# === Egebeya environment variables ===
# Values marked REQUIRED abort server startup when missing or set to a
# known-insecure default.

# ============================================================
# REQUIRED — authentication secrets (never hardcoded, never committed)
# ============================================================
# JWT signing secret for access tokens. REQUIRED in every environment
# (test mode uses a fixed key automatically).
JWT_SECRET=

# JWT signing secret for refresh tokens. REQUIRED.
REFRESH_SECRET=

# ============================================================
# REQUIRED — Chapa payment gateway (mandatory, no fallback)
# ============================================================
# Chapa secret key. REQUIRED in every environment. Use the test key
# (CHASECK_TEST-…) for dev and a live secret in production.
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxxxxxxxxxx

# Chapa webhook signature secret. REQUIRED — webhooks are rejected without a
# verifiable HMAC signature.
CHAPA_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxx

# ============================================================
# App / hosting
# ============================================================
# APP_URL: The URL where the app is hosted. Used for self-referential links
# (password-reset emails, widget embeds).
APP_URL=http://localhost:3000

# CORS origin allowlist (comma-separated). egebeya.et subdomains and
# localhost are always allowed; add any other frontend origin here.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# SMTP — leave blank to run the mailer in stub mode (dev)
# ============================================================
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=

# ============================================================
# Optional integrations
# ============================================================
# Gemini AI (optional; not used during core flow)
GEMINI_API_KEY=

# SMS gateway (Ethiopian) — not used during core flow
SMS_API_KEY=

# Sentry — same DSN for backend and frontend. Blank disables Sentry.
SENTRY_DSN=

# Cloudflare Turnstile — site key (public) + secret key (server-only).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Enable test-only endpoints (e.g. /api/test/send-email). NEVER true in prod.
ENABLE_TEST_ENDPOINTS=false
